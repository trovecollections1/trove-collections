---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="The Trove Portfolio — free illustrated companion | Trove Collections">
  <section class="magnet">
    <p class="kicker"><a href="/novel">← CITY OF TROVE</a></p>
    <h1>THE CITY, ILLUSTRATED</h1>
    <p class="lede">Trove was painted before it was published. Get <em>The Trove Portfolio</em> —
    the free illustrated companion to <em>City of Trove</em>: twenty-four full-page paintings from
    the making of the book, in story order, from a shore twelve thousand years gone to a door
    that opens.</p>

    <!-- Direct download for now; swap to email-capture (BookFunnel/other) before launch. -->
    <div class="signup">
      <p><a class="button" href="/downloads/the-trove-portfolio.pdf" download>
        Download the Portfolio (PDF) →</a></p>
      <p class="small muted">Thirteen more plates are still being painted. Want them as they're
      finished — and first word when Book Two's gate opens? Write us:
      <a href="mailto:hello@trovecollections.com?subject=Keep%20me%20posted%20on%20City%20of%20Trove">hello@trovecollections.com</a>.
      No spam, ever — the watch keeps its word.</p>
    </div>

    <hr />
    <p class="small muted">While you wait: <a href="/novel/chapter-one">Chapter One is free here</a>.</p>
  </section>
</Layout>

<style>
  .magnet { max-width: 42rem; margin: 0 auto; padding: 2rem 0 3rem; text-align: center; }
  .kicker a { letter-spacing: 0.14em; font-size: 0.8rem; color: var(--muted); border: 0; }
  .magnet h1 { letter-spacing: 0.12em; }
  .lede { font-size: 1.05rem; line-height: 1.7; text-align: left; }
  .signup { margin: 2rem 0; }
  .button { display: inline-block; padding: 0.7rem 1.4rem; border: 1px solid var(--ink); border-radius: 2px; }
  .small { font-size: 0.9rem; }
</style>
